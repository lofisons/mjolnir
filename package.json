{
  "name": "mjolnir",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "dev": "vite",
    "build": "sh scripts/build-wasm.sh && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:ui": "playwright test --trace off",
    "test": "cargo test --workspace && pnpm check && pnpm build && playwright test --trace off",
    "demos": "node tools/build_demos.mjs",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
