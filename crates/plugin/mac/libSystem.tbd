--- !tapi-tbd
# The symbols of macOS's libSystem that Mjolnir's plugin uses, listed by hand so
# the plugin can be linked on any machine. Add a name here when the linker
# reports it undefined.
tbd-version: 4
targets: [ arm64-macos, x86_64-macos ]
install-name: '/usr/lib/libSystem.B.dylib'
current-version: 1
exports:
  - targets: [ arm64-macos, x86_64-macos ]
    symbols:
      - '_CCRandomGenerateBytes'
      - '__Unwind_Backtrace'
      - '__Unwind_GetDataRelBase'
      - '__Unwind_GetIP'
      - '__Unwind_GetIPInfo'
      - '__Unwind_GetLanguageSpecificData'
      - '__Unwind_GetRegionStart'
      - '__Unwind_GetTextRelBase'
      - '__Unwind_Resume'
      - '__Unwind_SetGR'
      - '__Unwind_SetIP'
      - '___bzero'
      - '___error'
      - '___exp10f'
      - '___sincosf_stret'
      - '__dyld_get_image_header'
      - '__dyld_get_image_name'
      - '__dyld_get_image_vmaddr_slide'
      - '__dyld_image_count'
      - '__tlv_atexit'
      - '__tlv_bootstrap'
      - '_abort'
      - '_bzero'
      - '_calloc'
      - '_clock_gettime'
      - '_close'
      - '_close$NOCANCEL'
      - '_closedir'
      - '_dirfd'
      - '_dispatch_release'
      - '_dispatch_semaphore_create'
      - '_dispatch_semaphore_signal'
      - '_dispatch_semaphore_wait'
      - 'dyld_stub_binder'
      - '_exp2'
      - '_exp2f'
      - '_expf'
      - '_fmod'
      - '_free'
      - '_fstat'
      - '_fstat$INODE64'
      - '_getcwd'
      - '_getenv'
      - '_log2f'
      - '_malloc'
      - '_memcmp'
      - '_memcpy'
      - '_memmove'
      - '_memset'
      - '_memset_pattern16'
      - '_mmap'
      - '_mprotect'
      - '_munmap'
      - '_nanosleep'
      - '_open'
      - '_opendir'
      - '_opendir$INODE64'
      - '_pause'
      - '_posix_memalign'
      - '_powf'
      - '_pthread_attr_destroy'
      - '_pthread_attr_init'
      - '_pthread_attr_setstacksize'
      - '_pthread_create'
      - '_pthread_detach'
      - '_pthread_get_stackaddr_np'
      - '_pthread_get_stacksize_np'
      - '_pthread_join'
      - '_pthread_mutex_destroy'
      - '_pthread_mutex_init'
      - '_pthread_mutex_lock'
      - '_pthread_mutex_trylock'
      - '_pthread_mutex_unlock'
      - '_pthread_mutexattr_destroy'
      - '_pthread_mutexattr_init'
      - '_pthread_mutexattr_settype'
      - '_pthread_self'
      - '_pthread_setname_np'
      - '_pthread_threadid_np'
      - '_readdir_r'
      - '_readdir_r$INODE64'
      - '_realloc'
      - '_sigaltstack'
      - '_sin'
      - '_sinf'
      - '_strerror_r'
      - '_strlen'
      - '_sysconf'
      - '_tanf'
      - '_tanhf'
      - '_write'
      - '_writev'
...
